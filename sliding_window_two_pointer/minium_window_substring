        int n = s.size();
        int m = t.size();
        int minlen = INT_MAX;
        int Sidx = -1;
        int l = 0, r = 0;
        int cnt = 0;
        vector<int> hash(256, 0);

        for (int k = 0; k < m; k++)
        {
            hash[t[k]]++;
        }
        while (r < n)
        {
            if (hash[s[r]] > 0)
                cnt++;
            hash[s[r]]--;

            while (cnt == m)
            {
                int len = r - l + 1;
                if (minlen > len)
                {
                    minlen = len;
                    Sidx = l;
                }

                hash[s[l]]++;
                if (hash[s[l]] > 0)
                    cnt--;
                l++;
            }
            r++;
        }
        return (Sidx == -1) ? "" : s.substr(Sidx, minlen);
